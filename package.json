{
  "name": "sarian-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for SariAN",
  "main": "server.js",
  "scripts": {
    "postinstall": "node -e \"const https=require('https'),fs=require('fs');function get(u){https.get(u,r=>{if(r.statusCode>=300&&r.statusCode<400&&r.headers.location)return get(r.headers.location);if(r.statusCode!==200){console.error('Download gagal, status:',r.statusCode);process.exitCode=1;return}const f=fs.createWriteStream('yt-dlp',{mode:493});r.pipe(f);f.on('finish',()=>f.close(()=>console.log('yt-dlp selesai diunduh')))}).on('error',e=>{console.error(e);process.exitCode=1})}get('https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp')\"",
    "start": "node server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0"
  }
}
